---
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_TITLE } from '../consts';
import { projects } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Projects | ${SITE_TITLE}`} description="A selection of things I've built.">
	<h1>Projects</h1>
	<div class="grid">{projects.map((p) => <ProjectCard {...p} />)}</div>
</BaseLayout>

<style>
	.grid {
		display: grid;
		gap: 1rem;
	}
</style>
