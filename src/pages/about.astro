---
import { SITE_TITLE } from '../consts';
import { education, experience, profile, skills } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`About | ${SITE_TITLE}`} description={`About ${profile.name}: skills, experience and education.`}>
	<h1>About</h1>
	{profile.bio.map((p) => <p>{p}</p>)}
	<p>
		<a href={`mailto:${profile.email}`}>{profile.email}</a>
		{profile.links.map((l) => <> · <a href={l.href} rel="me noopener">{l.label}</a></>)}
	</p>

	<h2>Skills</h2>
	<dl class="skills">
		{
			skills.map((s) => (
				<>
					<dt>{s.group}</dt>
					<dd><ul class="tags">{s.items.map((i) => <li class="tag">{i}</li>)}</ul></dd>
				</>
			))
		}
	</dl>

	<h2>Experience</h2>
	{
		experience.map((e) => (
			<div class="entry">
				<div class="head">
					<h3>{e.role} · {e.company}</h3>
					<span class="muted">{e.start} – {e.end}</span>
				</div>
				<p>{e.summary}</p>
				<ul>{e.highlights.map((h) => <li>{h}</li>)}</ul>
			</div>
		))
	}

	<h2>Education</h2>
	{
		education.map((e) => (
			<div class="entry">
				<div class="head">
					<h3>{e.degree} · {e.school}</h3>
					<span class="muted">{e.start} – {e.end}</span>
				</div>
				{e.notes && <p>{e.notes}</p>}
			</div>
		))
	}
</BaseLayout>

<style>
	.skills {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.6rem 1.5rem;
		margin: 0;
	}
	dt {
		font-weight: 600;
	}
	dd {
		margin: 0;
	}
	dd .tags {
		margin: 0.3rem 0 0;
	}
	.entry {
		margin-bottom: 1.5rem;
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 0 1rem;
	}
	.head h3 {
		margin: 0;
	}
	@media (max-width: 600px) {
		.skills {
			grid-template-columns: 1fr;
		}
	}
</style>
