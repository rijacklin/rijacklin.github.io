---
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { profile, projects } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../utils/posts';

const posts = (await getPosts()).slice(0, 5);
const featured = projects.filter((p) => p.featured);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<h1>Hi, I’m {profile.name.split(' ')[0]}.</h1>
		<p class="lead">{profile.tagline}</p>
		<p class="muted">
			{profile.role} · {profile.location} · <a href="/about">More about me →</a>
		</p>
	</section>

	<section>
		<h2>Latest posts</h2>
		<PostList posts={posts} />
		<p><a href="/blog">All posts →</a></p>
	</section>

	{
		featured.length > 0 && (
			<section>
				<h2>Featured projects</h2>
				<div class="grid">{featured.map((p) => <ProjectCard {...p} />)}</div>
				<p><a href="/projects">All projects →</a></p>
			</section>
		)
	}
</BaseLayout>

<style>
	.intro {
		margin-bottom: 3rem;
	}
	.lead {
		font-size: 1.35rem;
		line-height: 1.5;
	}
	.grid {
		display: grid;
		gap: 1rem;
		margin-bottom: 1rem;
	}
</style>
