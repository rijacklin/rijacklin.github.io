---
import { profile } from '../data/profile';
---

<footer>
	<div class="container">
		<span>&copy; {new Date().getFullYear()} {profile.name}</span>
		<span class="links">
			{profile.links.map((l) => <a href={l.href} rel="me noopener">{l.label}</a>)}
			<a href={`mailto:${profile.email}`}>Email</a>
			<a href="/rss.xml">RSS</a>
		</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.9rem;
	}
	.container {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-top: 1.5rem;
		padding-bottom: 2.5rem;
	}
	.links {
		display: flex;
		gap: 1rem;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--text);
	}
</style>
