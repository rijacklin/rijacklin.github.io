---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---

<ul class="posts">
	{
		posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`}>
					<span class="date muted">
						<FormattedDate date={post.data.pubDate} />
						{post.data.draft && ' · draft'}
					</span>
					<span class="title">{post.data.title}</span>
					<span class="desc muted">{post.data.description}</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.posts {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	li + li {
		margin-top: 0.5rem;
	}
	a {
		display: block;
		padding: 0.9rem 1rem;
		margin: 0 -1rem;
		border-radius: 10px;
		text-decoration: none;
		color: var(--text);
		line-height: 1.5;
	}
	a:hover {
		background: var(--surface);
	}
	span {
		display: block;
	}
	.date {
		font-size: 0.85rem;
	}
	.title {
		font-size: 1.25rem;
		font-weight: 650;
	}
	a:hover .title {
		color: var(--accent);
	}
	.desc {
		font-size: 0.95rem;
	}
</style>
